{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}

<style>
    .articles-container {
        max-width: 1000px;
        margin: 40px auto;
        padding: 20px;
        font-family: Arial, sans-serif;
    }

    .articles-container h1 {
        color: #222;
        margin-bottom: 10px;
    }

    .description {
        color: #777;
        margin-bottom: 25px;
    }

    .articles-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

    .articles-table th,
    .articles-table td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    .articles-table th {
        background-color: #222;
        color: white;
    }

    .articles-table tbody tr:hover {
        background-color: #f5f5f5;
    }

    .badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 15px;
        font-size: 13px;
        font-weight: bold;
    }

    .published {
        background-color: #d4edda;
        color: #155724;
    }

    .draft {
        background-color: #fff3cd;
        color: #856404;
    }

    .total {
        margin-top: 20px;
        color: #555;
        font-weight: bold;
    }

    .btn-new {
        display: inline-block;
        margin-bottom: 20px;
        padding: 10px 16px;
        background-color: #222;
        color: white;
        text-decoration: none;
        border-radius: 5px;
    }

    .btn-new:hover {
        background-color: #444;
        color: white;
    }

    .btn-details {
        color: #0d6efd;
        text-decoration: none;
    }

    .btn-details:hover {
        text-decoration: underline;
    }
</style>

<div class="articles-container">

    <h1>Liste des articles</h1>

    <p class="description">
        Découvrez tous les articles disponibles.
    </p>

    <a href="{{ path('app_article_new') }}" class="btn-new">
        + Ajouter un article
    </a>

    {% if articles is empty %}

        <p>Aucun article disponible.</p>

    {% else %}

        <table class="articles-table">

            <thead>
                <tr>
                    <th>#</th>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                {% for article in articles %}

                    <tr>
                        <td>{{ loop.index }}</td>

                        <td>{{ article.titre }}</td>

                        <td>{{ article.auteur }}</td>

                        <td>
                            {% if article.publie %}
                                <span class="badge published">Publié</span>
                            {% else %}
                                <span class="badge draft">Brouillon</span>
                            {% endif %}
                        </td>

                        <td>
                            <a href="{{ path('app_article_show', {'id': article.id}) }}"
                               class="btn-details">
                                Voir détails
                            </a>
                        </td>
                    </tr>

                {% endfor %}

            </tbody>

        </table>

        <p class="total">
            Total : {{ articles|length }} article(s)
        </p>

    {% endif %}

</div>

{% endblock %}
