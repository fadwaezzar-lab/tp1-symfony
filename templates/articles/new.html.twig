{% extends 'base.html.twig' %}

{% block title %}New Article{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Add a New Article</h1>

    <form method="POST">
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" name="titre" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Content</label>
            <textarea name="contenu" class="form-control" rows="5" required></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Author</label>
            <input type="text" name="auteur" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Published?</label>
            <select name="publie" class="form-select">
                <option value="1">Yes</option>
                <option value="0">No</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Save Article</button>
        <a href="{{ path('app_articles') }}" class="btn btn-secondary">Cancel</a>
    </form>
</div>
{% endblock %}
