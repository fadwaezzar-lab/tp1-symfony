{% extends 'base.html.twig' %}

{% block title %}Task Details{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>{{ tache.titre }}</h1>

    <p><strong>Description:</strong> {{ tache.description ?? 'No description' }}</p>

    <p><strong>Status:</strong>
        {% if tache.terminee %}
            Completed
        {% else %}
            Pending
        {% endif %}
    </p>

    <p><strong>Created:</strong> {{ tache.dateCreation|date('d/m/Y H:i') }}</p>

    <a href="{{ path('app_taches') }}" class="btn btn-secondary">Back to list</a>
</div>
{% endblock %}
